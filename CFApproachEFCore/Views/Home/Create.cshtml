@model CFApproachEFCore.Models.Student

@{
    ViewData["Title"] = "Create";
}

<div class="container mt-4">

    <div class="card shadow-sm">
        <div class="card-body">

            <h2 class="text-success fw-bold mb-3">Create Student</h2>
            <hr />

            <div class="row">
                <div class="col-md-6 mx-auto">

                    <form asp-action="Create">

                        <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

                        <div class="form-group mb-3">
                            <label asp-for="Name" class="form-label fw-semibold"></label>
                            <input asp-for="Name" class="form-control" placeholder="Enter name" />
                            <span asp-validation-for="Name" class="text-danger small"></span>
                        </div>

                        <div class="form-group mb-3">
                            <label asp-for="Gender" class="form-label fw-semibold"></label>
                            <input asp-for="Gender" class="form-control" placeholder="Enter gender" />
                            <span asp-validation-for="Gender" class="text-danger small"></span>
                        </div>

                        <div class="form-group mb-3">
                            <label asp-for="Age" class="form-label fw-semibold"></label>
                            <input asp-for="Age" class="form-control" placeholder="Enter age" />
                            <span asp-validation-for="Age" class="text-danger small"></span>
                        </div>

                        <div class="form-group mb-3">
                            <label asp-for="Standard" class="form-label fw-semibold"></label>
                            <input asp-for="Standard" class="form-control" placeholder="Enter standard" />
                            <span asp-validation-for="Standard" class="text-danger small"></span>
                        </div>

                        <div class="d-flex justify-content-between mt-4">
                            <a asp-action="Index" class="btn btn-outline-secondary">← Back</a>
                            <input type="submit" value="Create" class="btn btn-success px-4" />
                        </div>

                    </form>

                </div>
            </div>

        </div>
    </div>

</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}