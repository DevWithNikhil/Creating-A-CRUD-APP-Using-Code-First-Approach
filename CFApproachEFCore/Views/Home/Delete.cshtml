@model CFApproachEFCore.Models.Student

@{
    ViewData["Title"] = "Delete";
}

<div class="container mt-4">

    <div class="card shadow-sm border-danger">
        <div class="card-body">

            <h2 class="text-danger fw-bold mb-2">Delete Student</h2>
            <p class="text-muted mb-3">Are you sure you want to delete this record?</p>

            <hr />

            <dl class="row">

                <dt class="col-sm-3 fw-semibold text-muted">
                    @Html.DisplayNameFor(model => model.Name)
                </dt>
                <dd class="col-sm-9 fw-semibold">
                    @Html.DisplayFor(model => model.Name)
                </dd>

                <dt class="col-sm-3 fw-semibold text-muted">
                    @Html.DisplayNameFor(model => model.Gender)
                </dt>
                <dd class="col-sm-9">
                    <span class="badge bg-info text-dark">
                        @Html.DisplayFor(model => model.Gender)
                    </span>
                </dd>

                <dt class="col-sm-3 fw-semibold text-muted">
                    @Html.DisplayNameFor(model => model.Age)
                </dt>
                <dd class="col-sm-9">
                    @Html.DisplayFor(model => model.Age)
                </dd>

                <dt class="col-sm-3 fw-semibold text-muted">
                    @Html.DisplayNameFor(model => model.Standard)
                </dt>
                <dd class="col-sm-9">
                    <span class="badge bg-primary">
                        @Html.DisplayFor(model => model.Standard)
                    </span>
                </dd>

            </dl>

            <div class="alert alert-warning mt-3">
                ⚠️ This action cannot be undone.
            </div>

            <form asp-action="Delete" class="mt-3">
                <input type="hidden" asp-for="Id" />

                <div class="d-flex justify-content-between">
                    <a asp-action="Index" class="btn btn-outline-secondary">← Back</a>
                    <input type="submit" value="Delete" class="btn btn-danger px-4" />
                </div>
            </form>

        </div>
    </div>

</div>